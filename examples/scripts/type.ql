# floats use a special notation
local my_float = 1.0f
println(f"my_float {my_float} => type: {type(my_float)}")

local b = 0xff
println(f"b {b} =>type: {type(b)}")

local c:byte = 0xff
println(f"c {c} =>type: {type(c)}")

# unsigned int
local my_uint = 44u
println(f"my_uint {my_uint} => type: {type(my_uint)}")

local a = 1.23
println(f"a {a} => type: {type(a)}")
